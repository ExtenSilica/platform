# Copy to `.env` and adjust. Never commit real secrets.

# ── Database (PostgreSQL — dev and prod use the same engine) ──────────────────
# Local: install PostgreSQL on the machine (or use Neon / Supabase for a dev URL).
# If Prisma says "invalid port number" (P1013), your USER or PASS likely contains
# URL-reserved characters. Percent-encode them, e.g. @ → %40, : → %3A, / → %2F, # → %23, % → %25
# (e.g. python3 -c "import urllib.parse; print(urllib.parse.quote('yourpass', safe=''))").
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/extensilica?schema=public"

PORT=3001
# xsilUrl = BASE_URL/uploads/<key>; API proxies from local or S3 for analytics.
BASE_URL=http://localhost:3001
SITE_URL=http://localhost:3000
STORAGE_DRIVER=local

# S3/R2 (production): STORAGE_DRIVER=s3 + S3_BUCKET, S3_REGION, S3_ENDPOINT, keys
# (see main .env template)

# Production example:
# DATABASE_URL="postgresql://USER:PASS@HOST:5432/extensilica?sslmode=require"
