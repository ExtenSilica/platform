# Copy to `.env` and adjust. Never commit real secrets.

# ── Database (PostgreSQL — dev and prod use the same engine) ──────────────────
# Local: install PostgreSQL on the machine (or use Neon / Supabase for a dev URL).
# If Prisma says "invalid port number" (P1013), your USER or PASS likely contains
# URL-reserved characters. Percent-encode them, e.g. @ → %40, : → %3A, / → %2F, # → %23, % → %25
# (e.g. python3 -c "import urllib.parse; print(urllib.parse.quote('yourpass', safe=''))").
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/extensilica?schema=public"

PORT=3001
# Public origin of this API (no trailing slash). Used for xsilUrl, upload URLs, password-reset links,
# and OAuth redirect_uri construction if you derive callbacks from BASE_URL.
BASE_URL=http://localhost:3001
# Behind a reverse proxy (production): default 1 hop so X-Forwarded-For works with express-rate-limit.
# Use TRUST_PROXY=0 only when Node is reached directly with no proxy sending X-Forwarded-*.
TRUST_PROXY=1
# Public origin of the web app (Next.js). Used for links in emails and post-login browser redirects.
SITE_URL=http://localhost:3000
STORAGE_DRIVER=local

# ── Platform admin (optional) ───────────────────────────────────────────────
# Operators may call GET/PATCH/POST /admin/* (also under /api/admin/*): health,
# user/package lists, force email verification, reassign package owner.
# They may also create organizations whose slug is otherwise reserved (e.g. extensilica).
# Use comma-separated numeric User.id values and/or emails (case-insensitive).
# Leave both empty to disable (no account is elevated).
PLATFORM_ADMIN_USER_IDS=
PLATFORM_ADMIN_EMAILS=

# ── Catalog-seed bots (optional) ──────────────────────────────────────────────
# Accounts whose publishes are auto-tagged with `portStatus = "seeded"` so the UI
# shows the "unverified port" badge until an upstream maintainer claims the row.
# Use comma-separated numeric User.id values and/or emails (case-insensitive).
# Leave blank if you don't run a catalog-seed agent yet.
PLATFORM_CATALOG_BOT_USER_IDS=
PLATFORM_CATALOG_BOT_EMAILS=

# ── OAuth (GitHub / Google) — optional; omit or leave blank to disable a provider ─────────────
# Each provider needs all three values or none; partial config logs a warning (provider disabled).
# Set OAUTH_STRICT_CONFIG=true to exit on startup if any provider is only partially configured.
#
# Secret for signing GitHub OAuth `state` cookies (min 16 chars). Required when GitHub OAuth is enabled.
OAUTH_STATE_SECRET=
#
# GitHub: create an OAuth App → Authorization callback URL must match GITHUB_CALLBACK_URL exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback
#
# Google: Cloud Console → OAuth 2.0 Client → Authorized redirect URIs must include GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
#
# OAUTH_STRICT_CONFIG=false

# Production examples (replace hosts and secrets):
# BASE_URL=https://api.extensilica.example
# SITE_URL=https://extensilica.example
# GITHUB_CALLBACK_URL=https://api.extensilica.example/auth/github/callback
# GOOGLE_CALLBACK_URL=https://api.extensilica.example/auth/google/callback

# S3/R2 (production): STORAGE_DRIVER=s3 + S3_BUCKET, S3_REGION, S3_ENDPOINT, keys
# (see main .env template)

# CONTACT_EMAIL=contact@extensilica.com
# SUPPORT_EMAIL=support@extensilica.com
# LEGAL_EMAIL=legal@extensilica.com

# Production example:
# DATABASE_URL="postgresql://USER:PASS@HOST:5432/extensilica?sslmode=require"
