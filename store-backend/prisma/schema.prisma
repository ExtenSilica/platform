// ExtenSilica XSIL registry — package catalog, user accounts, versions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ────────────────────────────────────────────────────

model User {
  id                         Int       @id @default(autoincrement())
  username                   String    @unique
  email                      String    @unique
  passwordHash               String
  apiToken                   String?   @unique
  /// Set when the user proves control of `email` (verify link or OAuth sign-up).
  emailVerifiedAt            DateTime?
  /// SHA-256 hex of the raw token emailed for verification; cleared after success.
  emailVerificationTokenHash String?   @unique
  emailVerificationExpires   DateTime?
  bio                        String?
  avatarUrl                  String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  ownedPackages       Extension[]          @relation("ExtensionOwner")
  maintainerships     Maintainer[]
  reviews             Review[]
  passwordResetTokens PasswordResetToken[]
  orgMemberships      OrgMember[]
  oauthAccounts       OAuthAccount[]
  toolArtifacts       ToolArtifact[]
  ownershipRequests   OwnershipRequest[]   @relation("OwnershipRequester")
  ownershipDecisions  OwnershipRequest[]   @relation("OwnershipDecider")
}

/// External identity from GitHub or Google OAuth (see docs/oauth-data-model.md).
model OAuthAccount {
  id                Int           @id @default(autoincrement())
  userId            Int
  provider          OAuthProvider
  providerAccountId String
  email             String?
  username          String?
  avatarUrl         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum OAuthProvider {
  github
  google
}

/// Honest classification of a package's relationship to the RISC-V standard.
/// Mirrored in `manifest.standardStatus` and rendered as a badge on the
/// package detail page. See docs/catalog-seed/catalog.md for the full rubric.
enum StandardStatus {
  /// Frozen specification approved by RISC-V International.
  ratified
  /// Working draft published under RISC-V International or another standards body.
  draft
  /// Custom extension defined and shipped by a commercial vendor.
  vendor
  /// Academic / experimental extension.
  research
  /// Bespoke / one-off extension that does not fit the above.
  custom
}

/// Provenance of the package on ExtenSilica — orthogonal to StandardStatus.
/// Always server-set, never read from the manifest, so publishers cannot
/// pretend a stub is "official". Transitions:
///   - Catalog-seed bot publishes      → `seeded`
///   - Non-upstream user publishes new → `community_port`
///   - OwnershipRequest approved on a `seeded` / `community_port` package
///     where the new owner credibly represents the upstream maintainer
///                                     → `claimed`
///   - Platform admin verifies identity → `official`
///   - Current owner / admin freezes   → `archived`
enum PortStatus {
  /// Auto-published by the catalog-seed agent. Owner is the platform bot.
  /// The original maintainer has NOT (yet) claimed or blessed this entry.
  seeded
  /// Ported by a non-upstream user; not vetted as official.
  community_port
  /// Original maintainer (or their org) has claimed authorship via the
  /// Request authorship flow.
  claimed
  /// Platform admin has verified the publisher's identity/affiliation.
  official
  /// Upstream is dead or the package has been intentionally frozen.
  archived
}

// ── Organisations ─────────────────────────────────────────────

model Organization {
  id          Int      @id @default(autoincrement())
  slug        String   @unique // e.g. "risc-v-foundation"  (no @)
  displayName String
  description String?
  avatarUrl   String?
  websiteUrl  String?
  /// Company LinkedIn profile URL (https://www.linkedin.com/company/…)
  linkedinUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  OrgMember[]
  packages Extension[] @relation("ExtensionOrg")
}

model OrgMember {
  id       Int      @id @default(autoincrement())
  orgId    Int
  userId   Int
  role     String   @default("member") // "owner" | "admin" | "member"
  joinedAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

// ── Packages ─────────────────────────────────────────────────

model Extension {
  id                   Int                @id @default(autoincrement())
  slug                 String             @unique // bare "pkgname" or scoped "@org/pkgname"
  name                 String
  description          String
  shortDescription     String?
  longDescription      String? // README / extended description (markdown)
  iconUrl              String?
  author               String
  ownerId              Int?
  orgId                Int? // set when published under an org scope
  keywords             String             @default("") // CSV
  license              String?
  repositoryUrl        String?
  homepageUrl          String?
  latestVersion        String?
  /// RL of semver-latest non-yanked version (denormalized; see syncExtensionLatestReadiness).
  latestReadinessLevel Int?
  totalDownloads       Int                @default(0)
  weeklyDownloads      Int                @default(0)
  isDeprecated         Boolean            @default(false)
  deprecationMessage   String? // optional reason / migration hint shown in the banner
  /// Honest classification: ratified | draft | vendor | research | custom.
  /// Nullable for legacy packages published before this field existed; new
  /// publishes (CLI / wizard / catalog-seed) MUST set it explicitly.
  standardStatus       StandardStatus?
  /// Free-text spec authority (e.g. "RISC-V International", "T-Head / XuanTie",
  /// "Qualcomm"). Rendered alongside the StandardStatus badge.
  authority            String?
  /// Provenance on ExtenSilica. SERVER-SET ONLY — never copied from the
  /// uploaded manifest. Null for legacy packages predating this field.
  portStatus           PortStatus?
  versions             Version[]
  maintainers          Maintainer[]
  reviews              Review[]
  downloadEvents       DownloadEvent[]
  ownershipRequests    OwnershipRequest[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  owner User?         @relation("ExtensionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  org   Organization? @relation("ExtensionOrg", fields: [orgId], references: [id], onDelete: SetNull)

  @@index([latestReadinessLevel])
  @@index([standardStatus])
  @@index([portStatus])
}

model Maintainer {
  id        Int      @id @default(autoincrement())
  packageId Int
  userId    Int
  role      String   @default("maintainer") // "owner" | "maintainer"
  addedAt   DateTime @default(now())

  package Extension @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([packageId, userId])
}

/// User-initiated request to be granted ownership of a package.
/// Reviewed by platform admins; on approval, sets Extension.ownerId to the
/// requester's userId and adds them as a Maintainer with role="owner".
/// Only one pending request per (package, user) is allowed at a time.
model OwnershipRequest {
  id           Int       @id @default(autoincrement())
  packageId    Int
  userId       Int
  /// Free-text justification supplied by the requester (50–2000 chars).
  reason       String
  /// Optional URL the user submits as evidence (e.g. GitHub commit, paper, email thread).
  evidenceUrl  String?
  /// "pending" | "approved" | "rejected" | "withdrawn"
  status       String    @default("pending")
  /// Admin-only message shown to the requester after approve/reject (optional).
  decisionNote String?
  /// Set by the platform admin who closed the request.
  decidedById  Int?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  package   Extension @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user      User      @relation("OwnershipRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?     @relation("OwnershipDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([packageId, status])
  @@index([userId, status])
  @@index([status, createdAt])
}

model Version {
  id              Int       @id @default(autoincrement())
  extensionId     Int
  extension       Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  version         String
  changelog       String    @default("")
  xsilUrl         String
  checksum        String? // sha256 of the full .xsil archive
  checksumPayload String? // sha256 of non-manifest files (was payloadHash)
  targets         String? // JSON blob from manifest targets
  toolchain       String?
  isa             String?
  /// Execution metadata blob from manifest (e.g. { entry, testEntry, env }).
  execution       String?
  /// Resolution policy (bundled | resolved | host-dependent).
  resolutionMode  String?
  /// Dependency declarations (e.g. tools list) as JSON.
  dependencies    String?
  /// Pre-silicon readiness level (RL) derived from stored manifest echoes.
  readinessLevel  Int?
  /// Capability list as JSON array of strings (derived; kept in sync with readinessLevel).
  capabilities    String?
  /// Optional `manifest.evidence` echo: JSON array of { kind, url, label?, sha256? }.
  evidence        String?
  size            Int? // archive bytes
  downloadCount   Int       @default(0)
  isYanked        Boolean   @default(false)
  yankReason      String?
  publishedAt     DateTime  @default(now())

  downloadEvents   DownloadEvent[]
  toolDependencies VersionToolDependency[]

  @@unique([extensionId, version])
}

model ToolArtifact {
  id          Int      @id @default(autoincrement())
  name        String
  version     String
  platform    String
  sha256      String   @unique
  size        Int
  storageKey  String   @unique
  sourceUrl   String?
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy    User                    @relation(fields: [createdById], references: [id], onDelete: Cascade)
  dependencies VersionToolDependency[]

  @@unique([name, version, platform, sha256])
  @@index([name, version, platform])
}

model VersionToolDependency {
  id             Int      @id @default(autoincrement())
  versionId      Int
  toolArtifactId Int
  toolName       String
  toolVersion    String
  platform       String
  declaredUrl    String
  declaredSha256 String
  createdAt      DateTime @default(now())

  version      Version      @relation(fields: [versionId], references: [id], onDelete: Cascade)
  toolArtifact ToolArtifact @relation(fields: [toolArtifactId], references: [id], onDelete: Restrict)

  @@unique([versionId, toolName, toolVersion, platform])
  @@index([toolArtifactId])
}

// ── Download analytics ────────────────────────────────────────

model DownloadEvent {
  id        Int    @id @default(autoincrement())
  packageId Int
  versionId Int
  day       String // "YYYY-MM-DD" bucket — one row per (package, version, day)
  count     Int    @default(1)

  package Extension @relation(fields: [packageId], references: [id], onDelete: Cascade)
  version Version   @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([packageId, versionId, day])
}

// ── Password reset ────────────────────────────────────────────

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique // SHA-256 of the raw token sent in the email
  expiresAt DateTime
  usedAt    DateTime? // set when redeemed; prevents replay
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Reviews ───────────────────────────────────────────────────

model Review {
  id        Int      @id @default(autoincrement())
  packageId Int
  userId    Int
  rating    Int // 1–5, validated at the application layer
  comment   String? // optional free-text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package Extension @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([packageId, userId]) // one review per user per package
}
