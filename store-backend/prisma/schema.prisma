// ExtenSilica XSIL registry — package catalog, user accounts, versions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ────────────────────────────────────────────────────

model User {
  id                         Int       @id @default(autoincrement())
  username                   String    @unique
  email                      String    @unique
  passwordHash               String
  /// Set when the user proves control of `email` (verify link or OAuth sign-up).
  emailVerifiedAt            DateTime?
  /// SHA-256 hex of the raw token emailed for verification; cleared after success.
  emailVerificationTokenHash String?   @unique
  emailVerificationExpires   DateTime?
  bio                        String?
  avatarUrl                  String?
  /// Public GitHub profile for implementation/coordination work (https://github.com/<user>).
  implementerGithubUrl       String?
  /// Short pitch shown when expressing interest in implementation requests (PR-B1).
  implementerBio             String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  ownedPackages       Extension[]          @relation("ExtensionOwner")
  maintainerships     Maintainer[]
  reviews             Review[]
  passwordResetTokens PasswordResetToken[]
  orgMemberships      OrgMember[]
  oauthAccounts       OAuthAccount[]
  toolArtifacts       ToolArtifact[]
  ownershipRequests   OwnershipRequest[]   @relation("OwnershipRequester")
  ownershipDecisions  OwnershipRequest[]   @relation("OwnershipDecider")
  apiTokens           ApiToken[]
  implementationRequestsCreated  ImplementationRequest[]  @relation("ImplementationRequestCreator")
  implementationRequestsAssigned ImplementationRequest[]  @relation("ImplementationRequestAssignee")
  implementationSubmissions      ImplementationSubmission[]
  implementationInterests        ImplementationInterest[]
  verificationRuns               VerificationRun[]          @relation("VerificationRunVerifier")
  contributedPorts               Port[]                     @relation("PortContributor")
  portStatusDecisions            Extension[]                @relation("PortStatusDecider")
  externalCitationsCreated       ExternalCitation[]         @relation("ExternalCitationCreator")
  tokenBalance                   TokenBalance?
  tokenGrants                    TokenGrant[]
  tokenGrantsApproved          TokenGrant[]               @relation("TokenGrantApprover")
}

/// Per-user XSIL balances (off-chain; no monetary value). See docs/spec-xsil-governance-token.md.
model TokenBalance {
  id        String @id @default(cuid())
  userId    Int    @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pendingXsil Int @default(0)
  claimedXsil Int @default(0)
  totalEarned Int @default(0)

  /// EVM address for governance claim (spec: walletAddress; not a payment account).
  linkedEvmAddress String?
  evmLinkedAt      DateTime?
  /// Nonce embedded in the sign-in message for wallet ownership verification.
  evmLinkNonce     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TokenGrant {
  id          String           @id @default(cuid())
  userId      Int
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  xsilAmount  Int
  reason      TokenGrantReason
  referenceId String
  note        String?

  status       TokenGrantStatus @default(PENDING)
  approvedById Int?
  approvedBy   User?            @relation("TokenGrantApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  claimTxHash  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, reason, referenceId])
  @@index([userId, status])
  @@index([userId, createdAt])
}

enum TokenGrantReason {
  FIRST_PACKAGE_PUBLISH
  PACKAGE_PUBLISH
  OWNERSHIP_CLAIM_APPROVED
  IMPLEMENTATION_SUBMISSION_ACCEPTED
  VERIFICATION_RUN_COMPLETED
  EXTERNAL_CITATION_VERIFIED
  CODE_CONTRIBUTION_MERGED
  VENDOR_CLAIM_APPROVED
  SECURITY_REPORT_FIXED
  ADMIN_DISCRETIONARY
}

enum TokenGrantStatus {
  PENDING
  APPROVED
  REJECTED
  CLAIMED
}

/// Named API credential. Each user may hold N independent tokens (web sessions,
/// CLI installs, CI bots…). The raw token is only ever shown to the client at
/// creation time; the server stores `sha256(raw)` so a database leak does not
/// expose credentials. Revocation is per-row, never global on login.
model ApiToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  /// Human label shown in `/dashboard/tokens` (e.g. "Web session — Firefox",
  /// "xsil-cli @ felipe-precision", "catalog-seed-bot"). 1–80 chars.
  name       String
  /// Lowercase hex SHA-256 of the raw 64-char token. Unique across all users.
  tokenHash  String    @unique
  /// Bumped by the auth middleware on every successful request (fire-and-forget).
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  /// Set when the user (or an admin) revokes the token. Revoked tokens are
  /// kept for audit but rejected by the auth middleware.
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// External identity from GitHub or Google OAuth (see docs/oauth-data-model.md).
model OAuthAccount {
  id                Int           @id @default(autoincrement())
  userId            Int
  provider          OAuthProvider
  providerAccountId String
  email             String?
  username          String?
  avatarUrl         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum OAuthProvider {
  github
  google
}

/// Honest classification of a package's relationship to the RISC-V standard.
/// Mirrored in `manifest.standardStatus` and rendered as a badge on the
/// package detail page. See docs/catalog-seed/catalog.md for the full rubric.
enum StandardStatus {
  /// Frozen specification approved by RISC-V International.
  ratified
  /// Working draft published under RISC-V International or another standards body.
  draft
  /// Custom extension defined and shipped by a commercial vendor.
  vendor
  /// Academic / experimental extension.
  research
  /// Bespoke / one-off extension that does not fit the above.
  custom
}

/// Provenance of the package on ExtenSilica — orthogonal to StandardStatus.
/// Always server-set, never read from the manifest, so publishers cannot
/// pretend a stub is "official". Transitions:
///   - Catalog-seed bot publishes      → `seeded`
///   - Non-upstream user publishes new → `community_port`
///   - OwnershipRequest approved on a `seeded` / `community_port` package
///     where the new owner credibly represents the upstream maintainer
///                                     → `claimed`
///   - Platform admin verifies identity → `official`
///   - Current owner / admin freezes   → `archived`
enum PortStatus {
  /// Auto-published by the catalog-seed agent. Owner is the platform bot.
  /// The original maintainer has NOT (yet) claimed or blessed this entry.
  seeded
  /// Ported by a non-upstream user; not vetted as official.
  community_port
  /// Original maintainer (or their org) has claimed authorship via the
  /// Request authorship flow.
  claimed
  /// Platform admin has verified the publisher's identity/affiliation.
  official
  /// Upstream is dead or the package has been intentionally frozen.
  archived
}

/// Distinguishes architectural catalog entries from legacy downloadable
/// artifacts that belong to one concrete Port. Port artifacts remain
/// addressable for installs and redirects, but never appear as Extensions.
enum ExtensionRecordKind {
  extension
  port_artifact
}

/// Coupling style declared by the extension for compatibility planning.
enum Coupling {
  TIGHTLY_COUPLED
  LOOSELY_COUPLED
  HYBRID
  UNKNOWN
}

/// Primary dispatch mechanism used by the extension implementation.
enum Dispatch {
  INLINE
  ROCC
  PREFIX
  TRAP_EMULATE
  UNKNOWN
}

// ── Organisations ─────────────────────────────────────────────

model Organization {
  id          Int      @id @default(autoincrement())
  slug        String   @unique // e.g. "risc-v-foundation"  (no @)
  displayName String
  description String?
  avatarUrl   String?
  websiteUrl  String?
  /// Company LinkedIn profile URL (https://www.linkedin.com/company/…)
  linkedinUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members           OrgMember[]
  packages          Extension[]         @relation("ExtensionOrg")
  ownershipRequests OwnershipRequest[]  @relation("OwnershipClaimantOrg")
  implementationRequests ImplementationRequest[] @relation("ImplementationRequestOrg")
}

model OrgMember {
  id       Int      @id @default(autoincrement())
  orgId    Int
  userId   Int
  role     String   @default("member") // "owner" | "admin" | "member"
  joinedAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

// ── Packages ─────────────────────────────────────────────────

model Extension {
  id                   Int                @id @default(autoincrement())
  slug                 String             @unique // bare "pkgname" or scoped "@org/pkgname"
  name                 String
  description          String
  shortDescription     String?
  longDescription      String? // README / extended description (markdown)
  iconUrl              String?
  author               String
  ownerId              Int?
  orgId                Int? // set when published under an org scope
  keywords             String             @default("") // CSV
  license              String?
  repositoryUrl        String?
  homepageUrl          String?
  latestVersion        String?
  /// RL of semver-latest non-yanked version (denormalized; see syncExtensionLatestReadiness).
  latestReadinessLevel Int?
  totalDownloads       Int                @default(0)
  weeklyDownloads      Int                @default(0)
  isDeprecated         Boolean            @default(false)
  deprecationMessage   String? // optional reason / migration hint shown in the banner
  recordKind           ExtensionRecordKind @default(extension)
  /// Honest classification: ratified | draft | vendor | research | custom.
  /// Nullable for legacy packages published before this field existed; new
  /// publishes (CLI / wizard / catalog-seed) MUST set it explicitly.
  standardStatus       StandardStatus?
  /// Free-text spec authority (e.g. "RISC-V International", "T-Head / XuanTie",
  /// "Qualcomm"). Rendered alongside the StandardStatus badge.
  authority            String?
  /// Provenance on ExtenSilica. SERVER-SET ONLY — never copied from the
  /// uploaded manifest. Null for legacy packages predating this field.
  portStatus           PortStatus?
  /// Compatibility metadata (Feature B).
  coupling             Coupling           @default(UNKNOWN)
  /// Claimed custom encoding spaces (e.g. custom-0/custom-1).
  encodingSpace        String[]           @default([])
  /// Claimed CSR ranges (e.g. "0x800-0x8FF").
  csrRange             String[]           @default([])
  /// Runtime dispatch mechanism used by this extension.
  dispatch             Dispatch           @default(UNKNOWN)
  /// Core features required by the extension (e.g. rocc-interface).
  requiresCoreFeatures String[]           @default([])
  /// Required audit trail when `portStatus` is set to `official` (platform admin only).
  portStatusDecisionNote String?
  portStatusDecidedById  Int?
  portStatusDecidedAt    DateTime?
  versions             Version[]
  maintainers          Maintainer[]
  reviews              Review[]
  downloadEvents       DownloadEvent[]
  viewEvents           PackageViewEvent[]
  externalCitations    ExternalCitation[]
  ownershipRequests    OwnershipRequest[]
  implementationRequests ImplementationRequest[]
  ports                Port[]
  artifactForPort      Port?              @relation("PortArtifactExtension")
  instructions         Instruction[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  owner User?         @relation("ExtensionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  org   Organization? @relation("ExtensionOrg", fields: [orgId], references: [id], onDelete: SetNull)
  portStatusDecidedBy User? @relation("PortStatusDecider", fields: [portStatusDecidedById], references: [id], onDelete: SetNull)

  @@index([latestReadinessLevel])
  @@index([standardStatus])
  @@index([portStatus])
  @@index([recordKind, createdAt])
}

/// Normalized instruction encodings extracted from package opcodes.json on publish.
/// Queryable/indexed source of truth for collision analysis and compatibility tooling.
model Instruction {
  id          Int       @id @default(autoincrement())
  extensionId Int
  /// Version string this encoding was extracted from.
  version     String
  mnemonic    String
  /// 7-bit major opcode as integer (0..127).
  opcode      Int
  /// Optional 3-bit funct field.
  funct3      Int?
  /// Optional 7-bit funct field.
  funct7      Int?
  /// Optional 12-bit I-immediate for I-singleton encodings (brev8/rev8/zip/unzip,
  /// scalar-crypto fixed-imm instructions, etc.) where rs2 is part of the imm.
  /// Mutually exclusive with funct7 in practice: R-type uses funct7, I-singleton uses funct12.
  funct12     Int?
  /// R, I, S, B, U, J, R4, I-singleton, custom...
  format      String
  /// Optional CSR address tied to the instruction.
  csrAddress  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  extension Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@index([extensionId])
  @@index([extensionId, version])
  @@index([opcode, funct3, funct7, funct12])
  @@index([csrAddress])
}

model Maintainer {
  id        Int      @id @default(autoincrement())
  packageId Int
  userId    Int
  role      String   @default("maintainer") // "owner" | "maintainer"
  addedAt   DateTime @default(now())

  package Extension @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([packageId, userId])
}

/// User-initiated request to be granted ownership of a package.
/// Reviewed by platform admins; on approval, sets Extension.ownerId to the
/// requester's userId and adds them as a Maintainer with role="owner".
/// Only one pending request per (package, user) is allowed at a time.
model OwnershipRequest {
  id           Int       @id @default(autoincrement())
  packageId    Int
  userId       Int
  /// Free-text justification supplied by the requester (50–2000 chars).
  reason       String
  /// Optional URL the user submits as evidence (e.g. GitHub commit, paper, email thread).
  evidenceUrl  String?
  /// "pending" | "approved" | "rejected" | "withdrawn"
  status       String    @default("pending")
  /// Admin-only message shown to the requester after approve/reject (optional).
  decisionNote String?
  /// Set by the platform admin who closed the request.
  decidedById  Int?
  decidedAt    DateTime?
  /// When set, the user claims on behalf of this organization (must be a member).
  claimantOrgId Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  package     Extension     @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user        User          @relation("OwnershipRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy   User?         @relation("OwnershipDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  claimantOrg Organization? @relation("OwnershipClaimantOrg", fields: [claimantOrgId], references: [id], onDelete: SetNull)

  @@index([packageId, status])
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([claimantOrgId])
}

model Version {
  id              Int       @id @default(autoincrement())
  extensionId     Int
  extension       Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  version         String
  changelog       String    @default("")
  xsilUrl         String
  checksum        String? // sha256 of the full .xsil archive
  checksumPayload String? // sha256 of non-manifest files (was payloadHash)
  targets         String? // JSON blob from manifest targets
  toolchain       String?
  isa             String?
  /// Execution metadata blob from manifest (e.g. { entry, testEntry, env }).
  execution       String?
  /// Resolution policy (bundled | resolved | host-dependent).
  resolutionMode  String?
  /// Dependency declarations (e.g. tools list) as JSON.
  dependencies    String?
  /// Pre-silicon readiness level (RL) derived from stored manifest echoes.
  readinessLevel  Int?
  /// Capability list as JSON array of strings (derived; kept in sync with readinessLevel).
  capabilities    String?
  /// Optional `manifest.evidence` echo: JSON array of { kind, url, label?, sha256? }.
  evidence        String?
  size            Int? // archive bytes
  downloadCount   Int       @default(0)
  isYanked        Boolean   @default(false)
  yankReason      String?
  publishedAt     DateTime  @default(now())

  downloadEvents   DownloadEvent[]
  toolDependencies VersionToolDependency[]
  implementationSubmissions ImplementationSubmission[]
  ports            Port[]

  @@unique([extensionId, version])
}

model ToolArtifact {
  id          Int      @id @default(autoincrement())
  name        String
  version     String
  platform    String
  sha256      String   @unique
  size        Int
  storageKey  String   @unique
  sourceUrl   String?
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy    User                    @relation(fields: [createdById], references: [id], onDelete: Cascade)
  dependencies VersionToolDependency[]

  @@unique([name, version, platform, sha256])
  @@index([name, version, platform])
}

model VersionToolDependency {
  id             Int      @id @default(autoincrement())
  versionId      Int
  toolArtifactId Int
  toolName       String
  toolVersion    String
  platform       String
  declaredUrl    String
  declaredSha256 String
  createdAt      DateTime @default(now())

  version      Version      @relation(fields: [versionId], references: [id], onDelete: Cascade)
  toolArtifact ToolArtifact @relation(fields: [toolArtifactId], references: [id], onDelete: Restrict)

  @@unique([versionId, toolName, toolVersion, platform])
  @@index([toolArtifactId])
}

// ── Download analytics ────────────────────────────────────────

model DownloadEvent {
  id        Int    @id @default(autoincrement())
  packageId Int
  versionId Int
  day       String // "YYYY-MM-DD" bucket — one row per (package, version, day)
  count     Int    @default(1)

  package Extension @relation(fields: [packageId], references: [id], onDelete: Cascade)
  version Version   @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([packageId, versionId, day])
}

/// Package page views — one row per (package, UTC day); PR-G1.
model PackageViewEvent {
  id        Int    @id @default(autoincrement())
  packageId Int
  day       String // "YYYY-MM-DD"
  count     Int    @default(1)

  package Extension @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, day])
  @@index([day])
}

/// Linked publication or DOI for a package (or registry-wide when packageId is null) — PR-G2.
model ExternalCitation {
  id              Int      @id @default(autoincrement())
  packageId       Int?
  label           String
  url             String
  /// doi | paper | website | other
  kind            String
  createdByUserId Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  package   Extension? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdBy User       @relation("ExternalCitationCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([kind])
}

// ── Password reset ────────────────────────────────────────────

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique // SHA-256 of the raw token sent in the email
  expiresAt DateTime
  usedAt    DateTime? // set when redeemed; prevents replay
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Reviews ───────────────────────────────────────────────────

model Review {
  id        Int      @id @default(autoincrement())
  packageId Int
  userId    Int
  rating    Int // 1–5, validated at the application layer
  comment   String? // optional free-text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package Extension @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([packageId, userId]) // one review per user per package
}

// ── Implementation coordination (Phase C) ─────────────────────

enum ImplementationRequestVisibility {
  public
  org_only
  unlisted
}

enum ImplementationRequestStatus {
  draft
  open
  in_progress
  submitted
  verified
  completed
  cancelled
}

enum TargetKind {
  simulator
  emulator
  core
  board
  toolchain
  reference
  other
}

enum PortVerificationStatus {
  declared
  built
  tested
  verified
  failed
  archived
}

/// A concrete execution or integration destination. A Target can be a simulator,
/// emulator, RTL core, board, toolchain, or reference model.
model Target {
  id           Int        @id @default(autoincrement())
  slug         String     @unique
  name         String
  kind         TargetKind @default(other)
  description  String?
  homepageUrl  String?
  architecture String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  ports                  Port[]
  implementationRequests ImplementationRequest[]

  @@index([kind, name])
}

/// Extension X running on Target Y with reproducible evidence. This is the
/// technical unit that can be verified and rewarded; Extension provenance is
/// deliberately kept separate.
model Port {
  id                    Int                    @id @default(autoincrement())
  extensionId           Int
  targetId              Int
  /// Stable integration/interface discriminator. This allows one Extension to
  /// have multiple implementations on the same Target (for example CV-X-IF
  /// and another CVA6 integration) without turning either into an Extension.
  backendSlug           String                 @default("default")
  backendName           String?
  versionId             Int?
  contributorId         Int?
  implementationRequestId Int?                @unique
  artifactExtensionId   Int?                    @unique
  verificationStatus    PortVerificationStatus @default(declared)
  testSummary           String?
  toolchain             String?
  sourceUrl             String?
  evidenceUrl           String?
  evidence              String?
  rewardXsil            Int?
  verifiedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  extension            Extension              @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  target               Target                 @relation(fields: [targetId], references: [id], onDelete: Cascade)
  version              Version?               @relation(fields: [versionId], references: [id], onDelete: SetNull)
  contributor          User?                  @relation("PortContributor", fields: [contributorId], references: [id], onDelete: SetNull)
  implementationRequest ImplementationRequest? @relation(fields: [implementationRequestId], references: [id], onDelete: SetNull)
  artifactExtension    Extension?              @relation("PortArtifactExtension", fields: [artifactExtensionId], references: [id], onDelete: SetNull)

  @@unique([extensionId, targetId, backendSlug])
  @@index([targetId, verificationStatus])
  @@index([extensionId, verificationStatus])
  @@index([contributorId])
}

/// Open technical work. When targetId is present this is a Port request and
/// rewardXsil is the non-monetary XSIL reward unlocked by verification.
model ImplementationRequest {
  id                        Int                             @id @default(autoincrement())
  packageId                 Int
  createdByUserId           Int
  createdByOrgId            Int?
  title                     String
  description               String
  visibility                ImplementationRequestVisibility @default(public)
  status                    ImplementationRequestStatus     @default(draft)
  /// Optional capability target (e.g. RL2, spike, tests).
  targetCapability          String?
  targetId                  Int?
  backendSlug               String?
  backendName               String?
  rewardXsil                Int?
  acceptanceCriteriaSummary String?
  /// Off-platform funding contact only — not a payment rail.
  fundingContactEmail       String?
  fundingNote               String?
  assignedImplementerUserId Int?
  openedAt                  DateTime?
  completedAt               DateTime?
  cancelledAt               DateTime?
  /// Set when a stale-open reminder email was sent (PR-C11).
  staleOpenNotifiedAt       DateTime?
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt

  package              Extension                  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdBy            User                       @relation("ImplementationRequestCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdByOrg         Organization?              @relation("ImplementationRequestOrg", fields: [createdByOrgId], references: [id], onDelete: SetNull)
  assignedImplementer  User?                      @relation("ImplementationRequestAssignee", fields: [assignedImplementerUserId], references: [id], onDelete: SetNull)
  target               Target?                    @relation(fields: [targetId], references: [id], onDelete: SetNull)
  port                 Port?
  milestones           ImplementationMilestone[]
  submissions          ImplementationSubmission[]
  interests            ImplementationInterest[]

  @@index([packageId, status])
  @@index([createdByUserId, status])
  @@index([status, createdAt])
  @@index([assignedImplementerUserId])
  @@index([targetId, status])
}

model ImplementationMilestone {
  id          Int      @id @default(autoincrement())
  requestId   Int
  title       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  request ImplementationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, sortOrder])
}

enum ImplementationSubmissionStatus {
  draft
  submitted
}

model ImplementationSubmission {
  id              Int                            @id @default(autoincrement())
  requestId       Int
  submittedById   Int
  status          ImplementationSubmissionStatus @default(draft)
  summary         String
  evidenceUrl     String?
  /// Optional published registry version tied to this deliverable.
  versionId       Int?
  submittedAt     DateTime?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  request     ImplementationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  submittedBy User                  @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  version     Version?              @relation(fields: [versionId], references: [id], onDelete: SetNull)
  verificationRuns VerificationRun[]

  @@index([requestId, status])
  @@index([submittedById])
}

enum VerificationRunOutcome {
  pass
  fail
}

model VerificationRun {
  id           Int                    @id @default(autoincrement())
  submissionId Int
  verifierId   Int
  outcome      VerificationRunOutcome
  notes        String?
  logUrl       String?
  createdAt    DateTime               @default(now())

  submission ImplementationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  verifier   User                     @relation("VerificationRunVerifier", fields: [verifierId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
}

model ImplementationInterest {
  id        Int      @id @default(autoincrement())
  requestId Int
  userId    Int
  message   String?
  createdAt DateTime @default(now())

  request ImplementationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
}
